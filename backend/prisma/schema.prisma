generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model News {
  id         String   @id
  slug       String   @unique
  date       String
  tag        String
  kind       String
  status     String
  title      String
  excerpt    String
  body       String
  photo      String
  issuerSlug String?
  issuer     Issuer?  @relation(fields: [issuerSlug], references: [slug], onDelete: SetNull, onUpdate: Cascade)
  i18n       Json     @default("{}")
  createdAt  DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(6)

  @@index([status, updatedAt(sort: Desc)])
  @@index([issuerSlug])
  @@map("news")
}

model ManagementPerson {
  id        String   @id
  slug      String   @unique
  name      String
  role      String
  groupId   String   @map("group_id")
  photo     String
  bio       String
  education String
  career    Json     @default("[]")
  sortOrder Int      @map("order")
  status    String
  i18n      Json     @default("{}")
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  @@index([groupId, sortOrder])
  @@map("management")
}

model Slide {
  id        String @id
  title     String
  text      String
  href      String
  value     String
  photo     String
  sortOrder Int    @map("order")
  i18n      Json   @default("{}")

  @@map("slides")
}

model Media {
  id        String   @id
  name      String
  url       String
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  @@map("media")
}

model Page {
  id        String   @id
  path      String   @unique
  title     String
  lead      String
  body      String
  status    String
  i18n      Json     @default("{}")
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@map("pages")
}

model MenuItem {
  id        String     @id
  label     String
  href      String
  menuGroup String     @map("group")
  sortOrder Int        @map("order")
  parentId  String?    @map("parent_id")
  parent    MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  children  MenuItem[] @relation("MenuTree")
  i18n      Json       @default("{}")

  @@index([parentId, sortOrder])
  @@map("menu")
}

model Request {
  id        String   @id
  source    String
  payload   Json     @default("{}")
  status    String
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@map("requests")
}

model User {
  id       String @id
  name     String
  email    String @unique
  role     String
  password String

  @@map("users")
}

model Visit {
  id   String   @id
  path String
  at   DateTime @db.Timestamptz(6)

  @@index([at(sort: Desc)])
  @@map("visits")
}

model Audit {
  id     String   @id
  action String
  entity String
  detail String
  actor  String
  at     DateTime @db.Timestamptz(6)

  @@index([at(sort: Desc)])
  @@map("audit")
}

model SiteSettings {
  id              String   @id
  tagline         String   @default("")
  address         String   @default("")
  phones          String   @default("")
  emails          String   @default("")
  fax             String   @default("")
  license         String   @default("")
  copyright       String   @default("")
  eduUrl          String   @default("")
  disclosurePhone String   @default("") @map("disclosure_phone")
  eduPhone        String   @default("") @map("edu_phone")
  i18n            Json     @default("{}")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

model HomeHub {
  id        String @id
  href      String
  title     String
  text      String
  photo     String
  sortOrder Int    @map("order")
  i18n      Json   @default("{}")

  @@map("hubs")
}

model Issuer {
  id        String         @id
  slug      String         @unique
  name      String
  activity  String         @default("")
  director  String         @default("")
  position  String         @default("")
  address   String         @default("")
  phone     String         @default("")
  registrar String         @default("")
  security  String         @default("")
  count     String         @default("")
  price     String         @default("")
  status    String         @default("")
  sortOrder Int            @map("order")
  updatedAt DateTime       @map("updated_at") @db.Timestamptz(6)
  listing   ListingEntry[]
  news      News[]

  @@index([sortOrder])
  @@map("issuers")
}

model ListingEntry {
  id          String   @id
  code        String   @unique
  category    String
  sortOrder   Int      @map("order")
  name        String
  issuerSlug  String?  @map("issuer_slug")
  issuer      Issuer?  @relation(fields: [issuerSlug], references: [slug], onDelete: SetNull, onUpdate: Cascade)
  security    String   @default("")
  price       String   @default("")
  cap         String   @default("")
  count       String   @default("")
  doc         String   @default("")
  symbols     String   @default("")
  industry    String   @default("")
  activity    String   @default("")
  listedAt    String   @default("") @map("listed_at")
  auditor     String   @default("")
  registrar   String   @default("")
  marketMaker String   @default("") @map("market_maker")
  documents   Json     @default("[]")
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(6)

  @@index([category, sortOrder])
  @@index([issuerSlug])
  @@map("listing")
}
