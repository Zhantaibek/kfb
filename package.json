{
  "name": "kse-kg",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "dev:web": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "build:web": "npm run build -w frontend",
    "build:api": "npm run build -w backend",
    "start": "npm run start -w frontend",
    "start:api": "npm run start -w backend",
    "lint": "npm run lint -w frontend",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:deploy -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:studio": "npm run db:studio -w backend",
    "prod:up": "docker compose up -d --build",
    "prod:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
