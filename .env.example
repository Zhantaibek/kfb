# Database
DATABASE_URL=postgres://kse:kse@localhost:5433/kse

# Backend
PORT=4000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Next.js server → API)
API_URL=http://localhost:4000

# Внешняя ссылка на учебную платформу (отдельный сервис, не проксируется сайтом)
NEXT_PUBLIC_EDU_URL=/education/app

# Учебный центр (/education/app). Таблицы — в схеме edu той же базы (EDU_DATABASE_URL выводится из DATABASE_URL).
# EDU_DATABASE_URL=postgres://kse:kse@localhost:5433/kse?schema=edu
# EDU_JWT_SECRET=                 # по умолчанию — производный от SESSION_SECRET
EDU_APP_URL=http://localhost:3000/education/app
# Почта для регистрации студентов (ссылка/код входа). Без SMTP регистрация недоступна.
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KSE Edu <noreply@kse.kg>"
MAGIC_LINK_TTL_MIN=30

# Живые данные торгов с kse.kg (раз в 15 минут). off — выключить, например без интернета.
# KSE_SYNC=off
