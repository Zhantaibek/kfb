# Database
DATABASE_URL=postgres://kse:kse@localhost:5433/kse

# Backend
PORT=4000
NODE_ENV=development
# В production — случайная строка от 32 символов; с заглушкой отсюда API не запустится.
SESSION_SECRET=change-me-to-a-long-random-string
# Первый админ на чистой базе в production (в разработке создаются демо admin/admin и editor/editor).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=   (от 12 символов)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Next.js server → API)
API_URL=http://localhost:4000

# Учебный центр — отдельный проект (репозиторий kse-edu). Сайт только ссылается на его адрес.
NEXT_PUBLIC_EDU_URL=http://localhost:5173/education/app/

# Живые данные торгов с kse.kg (раз в 15 минут). off — выключить, например без интернета.
# KSE_SYNC=off

# Эмитенты и листинг — из внешнего API (раз в 15 минут), в админке их не добавляют кнопкой.
# Пусто — синхронизация выключена. Формат ответа: backend/src/modules/issuers-sync/sync.ts
ISSUERS_API_URL=
LISTING_API_URL=

# Уведомления о заявках с форм сайта (пусто — только сохранение в базе, видно в админке «Заявки»).
# Почта: SMTP_URL вида smtps://user:password@smtp.example.kg:465, получатели через запятую.
SMTP_URL=
REQUEST_NOTIFY_EMAIL=
SMTP_FROM=
# Telegram: токен бота от @BotFather и id чата/группы, куда он добавлен.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Двухфакторный вход сотрудников (код из приложения-аутентификатора). По умолчанию обязателен в production,
# в разработке — по желанию (демо admin/admin входит без кода). on / off — задать явно.
# MFA_REQUIRED=

# Раскрытие информации: новые существенные факты со страниц эмитентов kse.kg, раз в 6 часов. off — выключить.
# DISCLOSURE_SYNC=off

# HTTPS (docker compose): домен сайта, указывающий на сервер, и почта для Let's Encrypt. Сертификат выпускается
# и продлевается сам (сервисы proxy и certbot). Пусто — сайт работает по HTTP (только для локального запуска).
# CORS_ORIGIN в production — https://<DOMAIN>.
DOMAIN=
LETSENCRYPT_EMAIL=
# LETSENCRYPT_STAGING=1   — тестовый сертификат Let's Encrypt (без лимитов), для пробного запуска
