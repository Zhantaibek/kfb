# Database
DATABASE_URL=postgres://kse:kse@localhost:5433/kse
# Пароль базы для docker compose (в production — свой, не «kse»).
POSTGRES_PASSWORD=kse

# Backend
PORT=4000
NODE_ENV=development
# В production обязателен: случайная строка от 32 символов (например, openssl rand -base64 48).
SESSION_SECRET=change-me-to-a-long-random-string
# Пароль первого администратора admin@kse.kg при пустой базе. В production обязателен, без него сервер не создаст админа.
ADMIN_PASSWORD=
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Next.js server → API)
API_URL=http://localhost:4000

# Учебный центр — отдельный проект (репозиторий kse-edu). Сайт только ссылается на его адрес.
NEXT_PUBLIC_EDU_URL=http://localhost:5173/education/app/

# Живые данные торгов с kse.kg (раз в 15 минут). off — выключить, например без интернета.
# KSE_SYNC=off

# Эмитенты — добавляются из внешнего источника по API. Адрес задаётся позже, пока пусто.
ISSUERS_API_URL=
# Бумаги (листинг) — тоже из внешнего источника по API. Пока пусто.
SECURITIES_API_URL=
