# Database
DATABASE_URL=postgres://kse:kse@localhost:5433/kse

# Backend
PORT=4000
NODE_ENV=development
# В production — случайная строка от 32 символов; с заглушкой отсюда API не запустится.
SESSION_SECRET=change-me-to-a-long-random-string
# Первый админ на чистой базе в production (в разработке создаются демо admin/admin и editor/editor).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=   (от 12 символов)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Next.js server → API)
API_URL=http://localhost:4000

# Учебный центр — отдельный проект (репозиторий kse-edu). Сайт только ссылается на его адрес.
NEXT_PUBLIC_EDU_URL=http://localhost:5173/education/app/

# Живые данные торгов с kse.kg (раз в 15 минут). off — выключить, например без интернета.
# KSE_SYNC=off

# Эмитенты и листинг — из внешнего API (раз в 15 минут), в админке их не добавляют кнопкой.
# Пусто — синхронизация выключена. Формат ответа: backend/src/modules/issuers-sync/sync.ts
ISSUERS_API_URL=
LISTING_API_URL=
